{
  "name": "portfolio",
  "private": true,
  "description": "Lint tooling for the portfolio site. None of these packages ship to visitors.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "npm run lint:js && npm run lint:html && npm run lint:html-security",
    "lint:js": "eslint --max-warnings=0 .",
    "lint:html": "htmlhint index.html",
    "lint:html-security": "node scripts/check-html-security.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-security": "^4.2.0",
    "globals": "^17.13.0",
    "htmlhint": "^1.9.2"
  }
}
